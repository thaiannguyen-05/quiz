# --- Database ---------------------------------------------------------------
# Prisma reads this from `.env` (the CLI does not load `.env.local`).
# Local Docker default (see compose.yaml):
DATABASE_URL="postgresql://quizdeck:quizdeck@localhost:5432/quizdeck?schema=public"
# Direct (unpooled) connection used by Prisma CLI for migrations.
# Locally it is the same database; on Neon use the host without `-pooler`.
DIRECT_URL="postgresql://quizdeck:quizdeck@localhost:5432/quizdeck?schema=public"

# Optional: only read by Docker Compose. Keep DATABASE_URL in sync if changed.
# POSTGRES_USER="quizdeck"
# POSTGRES_PASSWORD="quizdeck"
# POSTGRES_DB="quizdeck"
# POSTGRES_PORT="5432"

# --- Auth.js ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client)
# Authorized redirect URI for local development:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated allowlist. Required in production; when empty in development,
# any Google account is allowed.
ALLOWED_EMAILS=""
